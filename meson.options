option(
    'nvcomp',
    type: 'feature',
    value: 'auto',
    description: 'Enable the nvCOMP gpu and hybrid decompression backends',
)

option(
    'ablations',
    type: 'boolean',
    value: false,
    description: 'Compile in the CUDDL_ABLATE switches that turn optimisations off, for ablation studies; off, they cost nothing',
)

option(
    'rapids_cmake_source',
    type: 'string',
    value: '',
    description: 'Pre-fetched rapids-cmake source for nvbench on hosts without internet access; empty downloads it',
)

option(
    'driver_library_dir',
    type: 'string',
    value: '',
    description: 'Directory holding the real libcuda.so and libnvidia-ml.so, for toolkits that only ship stubs; empty lets CMake search',
)

option(
    'benchmarks',
    type: 'feature',
    value: 'auto',
    description: 'Build benchmarks for the library',
)

option(
    'tests',
    type: 'feature',
    value: 'auto',
    description: 'Build tests for the library',
)

option(
    'examples',
    type: 'feature',
    value: 'auto',
    description: 'Build examples for the library',
)

option(
    'cli_kmer_length',
    type: 'integer',
    min: 1,
    max: 31,
    value: 25,
    description: 'K-mer length compiled into the example CLIs',
)

option(
    'cli_buckets',
    type: 'combo',
    choices: ['2048', '4096', '8192'],
    value: '2048',
    description: 'Sketch bucket count compiled into the example CLIs',
)

option(
    'cli_exponent_bits',
    type: 'combo',
    choices: ['5', '6'],
    value: '5',
    description: 'Register exponent width compiled into the example CLIs; 6 leaves a 10-bit mantissa, 5 an 11-bit one',
)