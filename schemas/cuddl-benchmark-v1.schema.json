{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cuDDL benchmark result",
  "description": "Shared result envelope for all final cuDDL benchmark evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "operation",
    "scope",
    "datasets",
    "system",
    "measurements"
  ],
  "properties": {
    "schema": {
      "const": "cuddl-benchmark/v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "hll_comparison",
        "pairwise_accuracy",
        "pairwise_batch",
        "dynamic_demilog",
        "search_decision",
        "refseq_parity",
        "indexed_search",
        "fasta_pairwise"
      ]
    },
    "scope": {
      "enum": [
        "kernel",
        "end_to_end"
      ]
    },
    "datasets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/dataset"
      }
    },
    "system": {
      "$ref": "#/$defs/system"
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/measurement"
      }
    }
  },
  "$defs": {
    "scalar": {
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "scalar_map": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/scalar"
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "kernel",
        "architecture",
        "cpu",
        "logical_cpu_count",
        "ram_bytes"
      ],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "kernel": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "logical_cpu_count": {
          "type": "integer",
          "minimum": 1
        },
        "ram_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "gpu": {
          "type": "string",
          "minLength": 1
        },
        "compute_capability": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "sm_count": {
          "type": "integer",
          "minimum": 1
        },
        "gpu_ram_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "cuda_runtime_version": {
          "type": "integer",
          "minimum": 1
        },
        "cuda_driver_version": {
          "type": "integer",
          "minimum": 1
        },
        "cuda_compile_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "samples",
        "median_ms"
      ],
      "properties": {
        "samples": {
          "type": "integer",
          "minimum": 1
        },
        "median_ms": {
          "type": "number",
          "minimum": 0
        },
        "min_ms": {
          "type": "number",
          "minimum": 0
        },
        "max_ms": {
          "type": "number",
          "minimum": 0
        },
        "p95_ms": {
          "type": "number",
          "minimum": 0
        },
        "relative_stddev_percent": {
          "type": "number",
          "minimum": 0
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "case"
      ],
      "properties": {
        "implementation": {
          "$ref": "#/$defs/implementation"
        },
        "case": {
          "$ref": "#/$defs/scalar_map"
        },
        "metrics": {
          "$ref": "#/$defs/scalar_map"
        },
        "timings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/timing"
          }
        },
        "memory_bytes": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "metrics"
          ],
          "properties": {
            "metrics": {
              "minProperties": 1
            }
          }
        },
        {
          "required": [
            "timings"
          ],
          "properties": {
            "timings": {
              "minProperties": 1
            }
          }
        },
        {
          "required": [
            "memory_bytes"
          ],
          "properties": {
            "memory_bytes": {
              "minProperties": 1
            }
          }
        }
      ]
    }
  }
}
