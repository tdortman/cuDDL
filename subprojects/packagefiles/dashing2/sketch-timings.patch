+/// FASTX bytes on disk staged per sketching batch.
+static constexpr size_t resident_batch_bytes = size_t(1) << 30;
+
+/// Reads every record of @p path, a space-separated file list, opening files as bonsai does.
+static std::vector<std::string> staged_sequences(const std::string &path) {
+    std::vector<std::string> seqs;
+    for_each_substr([&](const std::string &subpath) {
+        const auto ends_with = [&](std::string_view suffix) {
+            return subpath.size() >= suffix.size() &&
+                   subpath.compare(subpath.size() - suffix.size(), suffix.size(), suffix) == 0;
+        };
+        std::FILE *pfp = nullptr;
+        gzFile fp = nullptr;
+        if(ends_with(".xz") || ends_with(".bz2") || ends_with(".zst")) {
+            const std::string cmd = std::string(ends_with(".xz") ? "xz" : ends_with(".bz2") ? "bzip2" : "zstd") + " -dc " + subpath;
+            pfp = ::popen(cmd.data(), "r");
+            if(!pfp) THROW_EXCEPTION(std::runtime_error("Failed to open popen call: " + cmd));
+            fp = gzdopen(::fileno(pfp), "rb");
+        } else {
+            fp = gzopen(subpath.data(), "rb");
+        }
+        if(!fp) THROW_EXCEPTION(std::runtime_error("Could not open file at " + subpath));
+        gzbuffer(fp, 1 << 18);
+        kseq_t *ks = kseq_init(fp);
+        while(kseq_read(ks) >= 0) seqs.emplace_back(ks->seq.s, ks->seq.l);
+        kseq_destroy(ks);
+        gzclose(fp);
+        if(pfp) ::pclose(pfp);
+    }, path);
+    return seqs;
+}
 
 
