diff --git a/src/resident.h b/src/resident.h
new file mode 100644
--- /dev/null
+++ b/src/resident.h
@@ -0,0 +1,21 @@
+#pragma once
+
+#include <chrono>
+
+namespace dashing2 {
+
+void cuddl_resident_compare_add(double milliseconds);
+
+class cuddl_resident_compare_interval {
+    std::chrono::steady_clock::time_point started_ = std::chrono::steady_clock::now();
+
+   public:
+    ~cuddl_resident_compare_interval() {
+        cuddl_resident_compare_add(
+            std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - started_)
+                .count()
+        );
+    }
+};
+
+}  // namespace dashing2
diff --git a/src/resident.cpp b/src/resident.cpp
new file mode 100644
--- /dev/null
+++ b/src/resident.cpp
@@ -0,0 +1,77 @@
+#include "resident.h"
+
+#include <cstdlib>
+#include <fstream>
+#include <mutex>
+
+namespace {
+
+class resident_timings {
+    using clock = std::chrono::steady_clock;
+
+    std::mutex mutex_;
+    size_t active_ = 0;
+    clock::time_point started_{};
+    clock::duration sketch_elapsed_{};
+    double compare_ms_ = 0;
+    bool enabled_ = false;
+    const char* path_ = nullptr;
+
+   public:
+    resident_timings() {
+        path_ = std::getenv("CUDDL_RESIDENT_TIMINGS");
+        enabled_ = path_ != nullptr && *path_ != '\0';
+    }
+
+    ~resident_timings() {
+        if (!enabled_) return;
+        std::ofstream output(path_, std::ios::trunc);
+        bool const compare = compare_ms_ > 0;
+        output << (compare ? "{\"resident_ms\":" : "{\"active_sketch_ms\":")
+               << (compare ? compare_ms_
+                           : std::chrono::duration<double, std::milli>(sketch_elapsed_).count())
+               << ",\"source\":\""
+               << (compare ? "steady_clock_cpu_wall" : "steady_clock_overlapped_fastx_wall")
+               << "\",\"device\":\"cpu\",\"input\":\""
+               << (compare ? "sketches" : "streamed_fastx") << "\"}";
+    }
+
+    void enter() {
+        if (!enabled_) return;
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (active_++ == 0) started_ = clock::now();
+    }
+
+    void leave() {
+        if (!enabled_) return;
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (--active_ == 0) sketch_elapsed_ += clock::now() - started_;
+    }
+
+    void add_compare(double milliseconds) {
+        if (enabled_) compare_ms_ += milliseconds;
+    }
+};
+
+resident_timings timings;
+
+}  // namespace
+
+namespace bns {
+
+void cuddl_resident_begin() {
+    timings.enter();
+}
+void cuddl_resident_end() {
+    timings.leave();
+}
+
+}  // namespace bns
+
+namespace dashing2 {
+
+void cuddl_resident_compare_add(double milliseconds) {
+    timings.add_compare(milliseconds);
+}
+
+}  // namespace dashing2
