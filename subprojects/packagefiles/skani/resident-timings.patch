diff --git a/src/resident.rs b/src/resident.rs
new file mode 100644
index 0000000..4455abd
--- /dev/null
+++ b/src/resident.rs
@@ -0,0 +1,94 @@
+use std::sync::LazyLock;
+use std::sync::atomic::{AtomicU32, AtomicU64, Ordering};
+use std::time::Instant;
+
+const TIMINGS_ENV_VAR: &str = "CUDDL_RESIDENT_TIMINGS";
+
+pub struct ResidentClock {
+    base: Instant,
+    active: AtomicU32,
+    started_ns: AtomicU64,
+    elapsed_ns: AtomicU64,
+}
+
+impl ResidentClock {
+    pub fn new() -> Self {
+        ResidentClock {
+            base: Instant::now(),
+            active: AtomicU32::new(0),
+            started_ns: AtomicU64::new(0),
+            elapsed_ns: AtomicU64::new(0),
+        }
+    }
+
+    fn now_ns(&self) -> u64 {
+        self.base.elapsed().as_nanos().min(u128::from(u64::MAX)) as u64
+    }
+
+    pub fn enter(&self) -> ResidentGuard<'_> {
+        let now = self.now_ns();
+        if self.active.fetch_add(1, Ordering::SeqCst) == 0 {
+            self.started_ns.store(now, Ordering::SeqCst);
+        }
+        ResidentGuard { owner: self }
+    }
+
+    pub fn elapsed_ms(&self) -> f64 {
+        self.elapsed_ns.load(Ordering::SeqCst) as f64 / 1_000_000.0
+    }
+
+    pub fn reset(&self) {
+        self.active.store(0, Ordering::SeqCst);
+        self.started_ns.store(0, Ordering::SeqCst);
+        self.elapsed_ns.store(0, Ordering::SeqCst);
+    }
+}
+
+impl Default for ResidentClock {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+pub struct ResidentGuard<'a> {
+    owner: &'a ResidentClock,
+}
+
+impl Drop for ResidentGuard<'_> {
+    fn drop(&mut self) {
+        let now = self.owner.now_ns();
+        if self.owner.active.fetch_sub(1, Ordering::SeqCst) == 1 {
+            let start = self.owner.started_ns.load(Ordering::SeqCst);
+            let delta = now.saturating_sub(start);
+            self.owner.elapsed_ns.fetch_add(delta, Ordering::SeqCst);
+        }
+    }
+}
+
+static SKETCH_CLOCK: LazyLock<ResidentClock> = LazyLock::new(ResidentClock::new);
+
+pub fn sketch_clock() -> &'static ResidentClock {
+    &SKETCH_CLOCK
+}
+
+pub fn emit(input: &'static str, resident_ms: f64) {
+    let path = match std::env::var(TIMINGS_ENV_VAR) {
+        Ok(path) => path,
+        Err(_) => return,
+    };
+    if path.is_empty() {
+        return;
+    }
+    let ms = if resident_ms.is_finite() && resident_ms >= 0.0 {
+        resident_ms
+    } else {
+        0.0
+    };
+    let payload = serde_json::json!({
+        "resident_ms": ms,
+        "source": "steady_clock_cpu_wall",
+        "device": "cpu",
+        "input": input,
+    });
+    std::fs::write(&path, payload.to_string()).expect("resident timing sidecar must write");
+}
