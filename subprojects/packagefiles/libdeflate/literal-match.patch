 #define HUFFDEC_PAIR 0x40000000U
+#define HUFFDEC_LITERAL_PAIR 0x20000000U
 
 static void build_pair_decode_table(struct libdeflate_decompressor *d)
 {
@@ -1089,6 +1090,20 @@
 			}
 		}
 		d->pair_decode_table[key] = result;
+	}
+	/* Fuse a literal and a short match when their prefixes fit one lookup. */
+	for (key = 0; key < (1U << LITLEN_TABLEBITS); key++) {
+		u64 entry = d->pair_decode_table[key];
+		if (entry & HUFFDEC_LITERAL) {
+			unsigned bits = (u8)entry;
+			u64 next = d->pair_decode_table[key >> bits];
+			unsigned prefix = bits + (u8)next - ((next >> 8) & 0xf);
+			if ((next & (HUFFDEC_PAIR | HUFFDEC_LITERAL_PAIR)) == HUFFDEC_PAIR &&
+			    prefix <= LITLEN_TABLEBITS) {
+				d->pair_decode_table[key] = (next + bits) | HUFFDEC_LITERAL_PAIR |
+					((u64)((entry >> 16) & 0xff) << 48);
+			}
+		}
 	}
 }
 
