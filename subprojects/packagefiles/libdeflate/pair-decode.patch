 	u16 sorted_syms[DEFLATE_MAX_NUM_SYMS];
@@ -1065,6 +1066,32 @@ build_offset_decode_table(struct libdeflate_decompressor *d,
 				  NULL);
 }
 
+#define HUFFDEC_PAIR 0x40000000U
+
+static void build_pair_decode_table(struct libdeflate_decompressor *d)
+{
+	unsigned key;
+	for (key = 0; key < (1U << LITLEN_TABLEBITS); key++) {
+		u32 le = d->u.litlen_decode_table[key & BITMASK(d->litlen_tablebits)];
+		u64 result = le;
+		unsigned length_bits = (u8)le;
+		if (!(le & (HUFFDEC_LITERAL | HUFFDEC_EXCEPTIONAL)) &&
+		    length_bits <= LITLEN_TABLEBITS) {
+			u32 de = d->offset_decode_table[(key >> length_bits) & BITMASK(OFFSET_TABLEBITS)];
+			unsigned prefix = length_bits + ((de >> 8) & 0x3f);
+			if (!(de & HUFFDEC_EXCEPTIONAL) && prefix <= LITLEN_TABLEBITS) {
+				unsigned length = (le >> 16) + ((key & BITMASK(length_bits)) >> (u8)(le >> 8));
+				unsigned extra = (u8)de - ((de >> 8) & 0x3f);
+				if (length <= 32) {
+					result = ((u64)(de >> 16) << 32) | HUFFDEC_PAIR |
+						 ((u64)length << 16) | (extra << 8) | (prefix + extra);
+				}
+			}
+		}
+		d->pair_decode_table[key] = result;
+	}
+}
