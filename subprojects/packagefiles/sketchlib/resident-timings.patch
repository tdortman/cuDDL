diff --git a/src/resident.rs b/src/resident.rs
new file mode 100644
index 0000000..f906de8
--- /dev/null
+++ b/src/resident.rs
@@ -0,0 +1,86 @@
+//! In-memory processing time for the micro comparison, written to the file named by
+//! `CUDDL_RESIDENT_TIMINGS`. The clock counts wall time while any thread is inside a guarded
+//! region, so concurrent workers are not summed and reading or writing outside the guards is
+//! excluded.
+use std::sync::atomic::{AtomicU32, AtomicU64, Ordering};
+use std::sync::LazyLock;
+use std::time::Instant;
+
+/// Wall time during which at least one guard is alive.
+pub struct ResidentClock {
+    base: Instant,
+    active: AtomicU32,
+    started_ns: AtomicU64,
+    elapsed_ns: AtomicU64,
+}
+
+impl ResidentClock {
+    fn now_ns(&self) -> u64 {
+        self.base.elapsed().as_nanos().min(u128::from(u64::MAX)) as u64
+    }
+
+    /// Starts a guarded region that lasts until the returned guard drops.
+    pub fn enter(&self) -> ResidentGuard<'_> {
+        let now = self.now_ns();
+        if self.active.fetch_add(1, Ordering::SeqCst) == 0 {
+            self.started_ns.store(now, Ordering::SeqCst);
+        }
+        ResidentGuard { owner: self }
+    }
+
+    fn elapsed_ms(&self) -> f64 {
+        self.elapsed_ns.load(Ordering::SeqCst) as f64 / 1_000_000.0
+    }
+}
+
+/// Keeps its clock running while alive.
+pub struct ResidentGuard<'a> {
+    owner: &'a ResidentClock,
+}
+
+impl Drop for ResidentGuard<'_> {
+    fn drop(&mut self) {
+        let now = self.owner.now_ns();
+        if self.owner.active.fetch_sub(1, Ordering::SeqCst) == 1 {
+            let start = self.owner.started_ns.load(Ordering::SeqCst);
+            self.owner
+                .elapsed_ns
+                .fetch_add(now.saturating_sub(start), Ordering::SeqCst);
+        }
+    }
+}
+
+fn new_clock() -> ResidentClock {
+    ResidentClock {
+        base: Instant::now(),
+        active: AtomicU32::new(0),
+        started_ns: AtomicU64::new(0),
+        elapsed_ns: AtomicU64::new(0),
+    }
+}
+
+static SKETCHING: LazyLock<ResidentClock> = LazyLock::new(new_clock);
+static COMPARING: LazyLock<ResidentClock> = LazyLock::new(new_clock);
+
+/// Packing and hashing sequences already read into memory.
+pub fn sketching() -> &'static ResidentClock {
+    &SKETCHING
+}
+
+/// Comparing or searching loaded sketches, apart from sketching queries and writing results.
+pub fn comparing() -> &'static ResidentClock {
+    &COMPARING
+}
+
+/// Writes @p clock's total for @p input when `CUDDL_RESIDENT_TIMINGS` names a file.
+pub fn emit(input: &str, clock: &ResidentClock) {
+    let Some(path) = std::env::var_os("CUDDL_RESIDENT_TIMINGS") else {
+        return;
+    };
+    let payload = format!(
+        "{{\"resident_ms\":{},\"source\":\"steady_clock_cpu_wall\",\"device\":\"cpu\",\
+         \"input\":\"{input}\"}}",
+        clock.elapsed_ms()
+    );
+    std::fs::write(path, payload).expect("resident timing sidecar must write");
+}
