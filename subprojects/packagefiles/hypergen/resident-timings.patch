@@ -0,0 +1,82 @@
+use std::fs;
+use std::sync::Mutex;
+use std::time::Instant;
+
+/// Union of active compute intervals across parallel workers.
+///
+/// Wall time, never summed thread-seconds: the clock runs while at least one
+/// worker holds an interval and banks the span when the last holder drops.
+pub struct ResidentClock {
+    inner: Mutex<ResidentInner>,
+}
+
+struct ResidentInner {
+    active: usize,
+    started: Option<Instant>,
+    elapsed_ms: f64,
+}
+
+/// RAII guard banking one active compute span on drop.
+pub struct ResidentInterval<'a> {
+    clock: &'a ResidentClock,
+}
+
+impl ResidentClock {
+    pub fn new() -> Self {
+        Self {
+            inner: Mutex::new(ResidentInner {
+                active: 0,
+                started: None,
+                elapsed_ms: 0.0,
+            }),
+        }
+    }
+
+    pub fn interval(&self) -> ResidentInterval<'_> {
+        let mut inner = self
+            .inner
+            .lock()
+            .expect("resident clock mutex poisoned by panicked worker");
+        if inner.active == 0 {
+            inner.started = Some(Instant::now());
+        }
+        inner.active += 1;
+        ResidentInterval { clock: self }
+    }
+
+    pub fn elapsed_ms(&self) -> f64 {
+        self.inner
+            .lock()
+            .expect("resident clock mutex poisoned by panicked worker")
+            .elapsed_ms
+    }
+}
+
+impl<'a> Drop for ResidentInterval<'a> {
+    fn drop(&mut self) {
+        let mut inner = self
+            .clock
+            .inner
+            .lock()
+            .expect("resident clock mutex poisoned by panicked worker");
+        inner.active -= 1;
+        if inner.active == 0 {
+            if let Some(started) = inner.started.take() {
+                inner.elapsed_ms += started.elapsed().as_secs_f64() * 1000.0;
+            }
+        }
+    }
+}
+
+/// Best-effort resident timing report for the micro-benchmark runner.
+/// No-op unless CUDDL_RESIDENT_TIMINGS names an output path.
+pub fn emit_resident_ms(source: &str, device: &str, input: &str, resident_ms: f64) {
+    let path = match std::env::var("CUDDL_RESIDENT_TIMINGS") {
+        Ok(path) if !path.is_empty() => path,
+        _ => return,
+    };
+    let payload = format!(
+        "{{\"resident_ms\":{resident_ms},\"source\":\"{source}\",\"device\":\"{device}\",\"input\":\"{input}\"}}"
+    );
+    fs::write(path, payload).expect("resident timing sidecar must write");
+}
